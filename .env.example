# Copy to .env and fill in. Never commit .env.

# Your domain (DNS A record pointing at the server), used by Caddy for HTTPS.
DOMAIN=preppilot.example.com

# Owner's key: powers the free demo tier. Leave empty to require users' own keys.
ANTHROPIC_API_KEY=

# Encrypts users' API keys at rest. Generate: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=

# Shared secret between the API and the code runner. Generate: openssl rand -hex 24
RUNNER_TOKEN=

# Demo tier limits.
DEMO_MESSAGES_PER_USER=10
DEMO_DAILY_TOKENS=400000

# Optional: model override.
# PREPPILOT_MODEL=claude-opus-5-5
