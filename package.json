{
  "name": "preppilot",
  "version": "1.0.0",
  "description": "AI interview coach that interviews you from your own JavaScript notes, runs your code in a sandbox, and tracks your weak topics.",
  "type": "module",
  "bin": {
    "preppilot": "bin/preppilot.js"
  },
  "files": [
    "bin",
    "src",
    "web"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env bin/preppilot.js serve",
    "test": "node --test",
    "search": "node bin/preppilot.js search",
    "prepublishOnly": "npm test",
    "cli": "node --env-file-if-exists=.env bin/preppilot.js"
  },
  "engines": {
    "node": ">=26"
  },
  "author": "Kumar Alok",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.45.1"
  },
  "keywords": [
    "javascript",
    "interview",
    "ai",
    "agent",
    "claude",
    "coding-interview",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlokSoe/preppilot.git"
  }
}
